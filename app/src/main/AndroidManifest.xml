<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Only on TVs up to Android 10 (Fire OS 7 and older), and only when the user asks to see
        backups in the Download folder. From Android 11 on it would only grant media files.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Starting after boot, only when the user turns it on (BootReceiver, AndroidAutoStart). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Nothing is drawn over other apps. From Android 10 on, holding this permission is the only
        exemption a user can grant from the ban on opening an activity from the background,
        which the boot start needs. It is not granted at install: the user turns it on in
        "Display over other apps" (or with adb on Fire TV, which hides that screen).
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- With package visibility (Android 11+), so Settings can tell whether that screen exists. -->
    <queries>
        <intent>
            <action android:name="android.settings.action.MANAGE_OVERLAY_PERMISSION" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <!-- One APK for phones and Fire TV: neither a touchscreen nor leanback is required. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!--
        Stream URLs can carry credentials, so the config never leaves the device:
        no backup and no device-to-device transfer. Cleartext is allowed because go2rtc's
        HTTP API usually runs on the LAN without TLS. requestLegacyExternalStorage only affects
        Android 10, where it lets a TV read backups from the Download folder (see above).
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.CamGrid"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Always enabled: it checks the setting itself (AndroidAutoStart). Switching the component
            on and off made the Fire TV launcher reload CamGrid and lose its tile. Exported because
            the system sends the boot broadcast; BOOT_COMPLETED is protected, so no other app can
            send it.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <!--
                Fire OS hands BOOT_COMPLETED to one receiver after another, highest priority
                first; at the default 0 CamGrid only got it 3 to 5 minutes after boot (issue #41).
                999 is the highest an app may ask for.
            -->
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
